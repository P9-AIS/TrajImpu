// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
  "name": "TrajImpu Dev Container",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "forwardPorts": [
    6006
  ],
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vsliveshare.vsliveshare",
        "ReprEng.csv"
      ]
    }
  },
  "runArgs": [
    "--gpus",
    "all",
    "--shm-size",
    "96gb",
    "--network",
    "trajviz_devcontainer_TrajNet"
  ],
  "mounts": [
    "type=bind,source=/mnt/dataimputationgroup/Data,target=${containerWorkspaceFolder}/Data",
    "type=bind,source=/mnt/dataimputationgroup/Outputs,target=${containerWorkspaceFolder}/Outputs"
  ],
  "shutdownAction": "none"
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
}